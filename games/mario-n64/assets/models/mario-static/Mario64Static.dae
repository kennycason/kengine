    <effect id="Material_0-fx" name="Material_0">
      <profile_COMMON>
        <newparam sid="Material_0-diffuse-surface">
          <surface type="2D">
            <init_from>Material_0-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="Material_0-diffuse-sampler">
          <sampler2D>
            <source>Material_0-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <phong>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <texture texture="Material_0-diffuse-sampler" texcoord="CHANNEL0" />
            </diffuse>
            <shininess>
              <float sid="shininess">0</float>
            </shininess>
            <transparency>
              <float sid="transparency">1</float>
            </transparency>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
